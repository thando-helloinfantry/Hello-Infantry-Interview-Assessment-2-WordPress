                    "return_format": "array",
                    "preview_size": "thumbnail",
                    "required": 0
                },
                {
                    "key": "field_team_name",
                    "label": "Name",
                    "name": "name",
                    "type": "text",
                    "required": 1
                },
                {
                    "key": "field_team_role",
                    "label": "Role",
                    "name": "role",
                    "type": "text",
                    "required": 0
                }
            ]
        }
