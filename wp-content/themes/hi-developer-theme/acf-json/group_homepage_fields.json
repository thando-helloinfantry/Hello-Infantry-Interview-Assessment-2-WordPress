{
    "key": "group_homepage_fields",
    "title": "Homepage Fields",
    "fields": [
        {
            "key": "field_hero_image",
            "label": "Hero Image",
            "name": "hero_image",
            "type": "image",
            "return_format": "array",
            "preview_size": "medium",
            "library": "all",
            "instructions": "Upload a hero background image for the homepage.",
            "required": 0
        },
        {
            "key": "field_hero_title",
            "label": "Hero Title",
            "name": "hero_title",
            "type": "text",
            "instructions": "The main heading displayed over the hero image.",
            "required": 0,
            "default_value": "Welcome to Hello Infantry"
        },
        {
            "key": "field_hero_subtitle",
            "label": "Hero Subtitle",
            "name": "hero_subtitle",
            "type": "textarea",
            "instructions": "A short description displayed below the hero title.",
