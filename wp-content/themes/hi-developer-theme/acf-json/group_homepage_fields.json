            "rows": 3,
            "new_lines": "br"
        },
        {
            "key": "field_service_items",
            "label": "Services",
            "name": "service_items",
            "type": "repeater",
            "instructions": "Add the services your agency offers.",
            "required": 0,
            "min": 0,
            "max": 12,
            "layout": "block",
            "sub_fields": [
                {
                    "key": "field_service_icon",
                    "label": "Icon",
                    "name": "icon",
                    "type": "text",
                    "instructions": "An emoji or icon character for this service.",
                    "required": 0
                },
                {
                    "key": "field_service_title",
                    "label": "Title",
                    "name": "title",
                    "type": "text",
                    "required": 1
                },
                {
                    "key": "field_service_description",
                    "label": "Description",
                    "name": "description",
                    "type": "textarea",
                    "required": 0,
                    "rows": 3
                }
            ]
        },
        {
            "key": "field_team_members",
            "label": "Team Members",
            "name": "team_members",
            "type": "repeater",
